{
  "name": "vscode-extensions-monorepo",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "check": "tsc -b",
    "build": "pnpm -r --sort run build",
    "watch": "pnpm -r --parallel --filter \"./extensions/*\" run watch",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean",
    "package": "pnpm -r --filter \"./extensions/*\" run package"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
